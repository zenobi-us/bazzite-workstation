FROM scratch AS ctx
COPY packages/image-common /common
COPY images/bazzite-workstation /image

# Reuse the published proprietary NVIDIA base so Pascal/GP107 hardware gets
# the legacy-compatible driver stack before applying shared workstation layers.
FROM ghcr.io/zenobi-us/bazzite-workstation-legacy-nvidia:latest

RUN --mount=type=bind,from=ctx,source=/,target=/ctx \
    --mount=type=cache,dst=/var/cache \
    --mount=type=cache,dst=/var/log \
    --mount=type=tmpfs,dst=/tmp \
    /ctx/common/build.sh /ctx/image

RUN bootc container lint