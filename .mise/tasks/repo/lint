#!/usr/bin/env bash
#MISE description="Lint all shell scripts"
#MISE depends=["//packages/image-common:lint", "//images/bazzite-workstation:lint", "//images/bazzite-workstation-legacy-nvidia:lint"]
set -euo pipefail
command -v shellcheck >/dev/null || { echo 'shellcheck could not be found. Please install it.' >&2; exit 1; }
find . -iname '*.sh' -type f -not -path './.git/*' -exec shellcheck '{}' +
